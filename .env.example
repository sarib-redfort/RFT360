# ==============================================================================
# RFT360 — Environment Configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ==============================================================================

# NODE_ENV is deliberately NOT set here.
# Each tool sets its own (next build => production, next dev => development,
# nest => development). Forcing it from .env breaks `next build`, which then
# fails to prerender /404 and /500.

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=rft360
POSTGRES_PASSWORD=rft360_dev_password
POSTGRES_DB=rft360
POSTGRES_PORT=5432
DATABASE_URL="postgresql://rft360:rft360_dev_password@localhost:5432/rft360?schema=public"

# ------------------------------------------------------------------------------
# Redis — cache, rate limiting, queues
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# API (NestJS)
# ------------------------------------------------------------------------------
API_PORT=4000
API_PREFIX=api
API_URL=http://localhost:4000

# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# JWT — GENERATE YOUR OWN before deploying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-dev-only-access-token-secret
JWT_REFRESH_SECRET=change-me-dev-only-refresh-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (requests per window, window in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ------------------------------------------------------------------------------
# Web (Next.js)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side API base (bypasses the browser; use the internal host in Docker).
API_INTERNAL_URL=http://localhost:4000/api/v1

# Public base URL that serves uploaded media. Leave blank to derive it from
# NEXT_PUBLIC_API_URL (correct for STORAGE_DRIVER=local). With STORAGE_DRIVER=s3
# this MUST equal the API's S3_PUBLIC_URL — the host is allowlisted for
# next/image and in the CSP, so a mismatch breaks every uploaded image.
NEXT_PUBLIC_MEDIA_URL=

# Auth.js — GENERATE YOUR OWN:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-dev-only-authjs-secret
AUTH_TRUST_HOST=true

# Where the API sends revalidation webhooks (the public site origin).
WEB_URL=http://localhost:3000

# Shared secret the API uses to trigger Next.js on-demand revalidation.
REVALIDATE_SECRET=change-me-dev-only-revalidate-secret

# ------------------------------------------------------------------------------
# Storage — `local` (default) or `s3`
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Public base URL that serves uploaded files.
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
MAX_UPLOAD_SIZE_MB=10

# Only needed when STORAGE_DRIVER=s3. Works with Supabase Storage (the deploy
# default, see DEPLOY.md), AWS S3, Cloudflare R2 and MinIO.
# Supabase requires S3_FORCE_PATH_STYLE=true and its real region, not "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# Email — Mailpit in dev (docker compose), real SMTP in production
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RFT360 <noreply@redfort360.com>"
# Where contact-form and job-application notifications are delivered.
MAIL_NOTIFY_TO=careers@redfort360.com

# ------------------------------------------------------------------------------
# Seed — the first CMS administrator. CHANGE THE PASSWORD BEFORE DEPLOYING.
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@redfort360.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="RFT360 Administrator"
